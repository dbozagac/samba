      "options": {
        "cwd": "${workspaceFolder}/apps/mobile"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Flutter Run Android (Samba)",
      "type": "shell",
      "command": "flutter",
      "args": ["run", "--dart-define-from-file=.env.mobile"],
      "options": {
        "cwd": "${workspaceFolder}/apps/mobile"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
